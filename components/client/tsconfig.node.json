{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2020",
    "lib": ["ES2020"],
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noEmit": true,
    "types": ["node"]
  },
  // Hotkey, Squad and LAN contracts are shared with the renderer, so their src
  // files are listed here. Both projects are noEmit, so compiling twice costs
  // nothing and keeps the main process from re-implementing the parsing.
  "include": ["vite.config.ts", "electron/**/*.ts", "src/lib/hotkeys.ts", "src/lib/squadMode.ts", "src/lib/easyTierCommunity.ts", "src/lib/memberLanStatus.ts", "src/lib/localDiagnostics.ts"]
}
