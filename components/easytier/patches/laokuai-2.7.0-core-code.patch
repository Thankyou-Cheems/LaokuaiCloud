+/// Reject alias/GUID reuse before rust-tun can open an existing user's adapter.
+pub fn laokuai_require_new_interface(name: &str, guid: uuid::Uuid) -> anyhow::Result<()> {
+    use winapi::shared::{guiddef::GUID, ifdef::NET_LUID, netioapi::ConvertInterfaceGuidToLuid};
+    let (data1, data2, data3, data4) = guid.as_fields();
+    let guid = GUID {
+        Data1: data1,
+        Data2: data2,
+        Data3: data3,
+        Data4: *data4,
+    };
+    let mut luid = NET_LUID::default();
+    if unsafe { ConvertInterfaceGuidToLuid(&guid, &mut luid) } == 0 {
+        anyhow::bail!("owned interface GUID already exists");
+    }
+    let interfaces = network_interface::NetworkInterface::show()?;
+    if interfaces.iter().any(|interface| interface.name == name) {
+        anyhow::bail!("refusing to open an existing interface alias");
+    }
+    Ok(())
+}
+
+/// Report identity from the newly requested GUID; alias never proves ownership.
+/// This receipt stays in Electron main, and contains no IP addresses or config.
+pub fn laokuai_report_owned_interface(guid: uuid::Uuid) -> anyhow::Result<()> {
+    use winapi::shared::{
+        guiddef::GUID,
+        ifdef::NET_LUID,
+        netioapi::{ConvertInterfaceGuidToLuid, ConvertInterfaceLuidToIndex},
+    };
+    let (data1, data2, data3, data4) = guid.as_fields();
+    let native_guid = GUID {
+        Data1: data1,
+        Data2: data2,
+        Data3: data3,
+        Data4: *data4,
+    };
+    let mut luid = NET_LUID::default();
+    let mut index = 0u32;
+    if unsafe { ConvertInterfaceGuidToLuid(&native_guid, &mut luid) } != 0
+        || unsafe { ConvertInterfaceLuidToIndex(&luid, &mut index) } != 0
+        || index == 0
+    {
+        anyhow::bail!("unable to verify the newly created interface identity");
+    }
+    use std::io::Write as _;
+    let mut output = std::io::stdout().lock();
+    writeln!(
+        output,
+        "LAOKUAI_OWNED_NIC_V1 {} {} {}",
+        guid, luid.Value, index
+    )?;
+    output.flush()?;
+    Ok(())
+}
