+// A dedicated OS thread avoids Tokio stdin's uncancellable blocking worker at exit.
+// Only the parent owning this anonymous pipe can request stop; there is no RPC mutation.
+fn laokuai_owned_stop_pipe() -> tokio::sync::oneshot::Receiver<()> {
+    let (send, receive) = tokio::sync::oneshot::channel();
+    std::thread::spawn(move || {
+        use std::io::Read as _;
+        let mut command = [0u8; 22];
+        // EOF or malformed input also stops: fail closed if the owner disappears.
+        let _ = std::io::stdin().lock().read_exact(&mut command);
+        let _ = send.send(());
+    });
+    receive
+}
