+
+/// A TUN device for iOS.
+pub struct Device {
+    tun: Tun,
+}
+
+impl AsRef<dyn AbstractDevice + 'static> for Device {
+    fn as_ref(&self) -> &(dyn AbstractDevice + 'static) {
