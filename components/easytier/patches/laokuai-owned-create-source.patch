+    let dev = tun2::create(&config)?;
+    let (mut reader, mut writer) = dev.split();
+
+    let (tx, rx) = std::sync::mpsc::channel();
+
+    let _t1 = std::thread::spawn(move || {
+        let mut buf = [0; 4096];
+        loop {
+            let size = reader.read(&mut buf)?;
+            let pkt = &buf[..size];
+            use std::io::{Error, ErrorKind::Other};
