+
+impl AsyncDevice {
+    /// Create a new `AsyncDevice` wrapping around a `Device`.
+    pub fn new(device: Device) -> io::Result<AsyncDevice> {
+        let session = WinSession::new(device.tun.get_session())?;
+        Ok(AsyncDevice {
