# Review-only SFU rollback state matching the currently observed six-peer
# deployment. Remove the candidate-only keys instead of setting them to a new
# profile; an unset policy keeps the source-compatible 48 kbps/20 ms default.
MAX_PEERS=6
SFU_HYBRID_ENABLED=true
SFU_AUDIO_ONLY=true
SFU_REQUIRE_CLIENT_TOKEN=true

# These keys must be absent from the rollback environment:
# SFU_MICROPHONE_OPUS20
# SFU_MICROPHONE_OPUS_MAX_AVERAGE_BITRATE_BPS
# SFU_MICROPHONE_OPUS_PTIME_MS
